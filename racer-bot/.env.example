# Telegram BotFather token
BOT_TOKEN=
# Google AI Studio API key
GEMINI_KEY=
# Comma-separated Telegram numeric user IDs
ADMIN_IDS=
# Comma-separated allowed chat IDs, e.g. -1001234567890
# ใส่ Discussion Group IDs ที่รับหลักฐานและคำสั่ง /new_task
ALLOWED_CHAT=
# Comma-separated Channel IDs ที่ต้องการติดตาม channel_post; ว่าง = ทุก channel ที่บอทเห็น
ACTIVE_CHANNEL_IDS=
# Chat ID for hourly reports; optional
ADMIN_CHAT=
# ISO local datetime, e.g. 2026-10-16T23:59:00
DEADLINE=2026-10-16T23:59:00
# Railway supplies PORT automatically; local default is 8080
WEB_PORT=8080
# Set this to protect the dashboard; leave empty only for private/local use
DASHBOARD_TOKEN=
DB_PATH=score.db
BACKUP_DIR=backups
CHECK_REPEAT_RATE=0.20
# Optional: POST ผลตรวจจริงเข้า Racer Board API
RACER_WEBHOOK_URL=
RACER_WEBHOOK_SECRET=
# X API v2 app Bearer Token สำหรับอ่านโพสต์และ public_metrics
X_BEARER_TOKEN=
# โพสต์ X ที่ต้องติดตามแบบ polling คั่นด้วย comma; Task ที่ link แล้วจะถูกติดตามอัตโนมัติ
X_POST_IDS=
# กำหนด rule สำหรับ X Filtered Stream ใกล้เรียลไทม์ เช่น from:your_account -is:retweet
X_FILTERED_STREAM_RULE=
X_POLL_SECONDS=30
# Telegram chat IDs ที่รับแจ้งเตือน X post ใหม่และ Task ใกล้ deadline คั่นด้วย comma
TELEGRAM_NOTIFY_CHAT_IDS=
# แจ้งเตือนก่อน Task หมดเขตกี่นาที
TASK_DEADLINE_WARN_MINUTES=60
